{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keypenproduce",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Every 5 minutes: open/close due windows, reminders, inventory backstop.
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keypenproduce-db",
      "database_id": "e0d75187-2d2d-4676-9c2c-bab55b8e2f3e",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "keypenproduce-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "50bb32726ff5442196a8596b52448969"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRODUCT_ADMIN_AGENT",
        "class_name": "ProductAdminAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProductAdminAgent"]
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "APP_TIMEZONE": "America/Los_Angeles"
  }
}
